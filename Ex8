//8. 구구단 출력(단이 세로로 출력되게 하시오.) 제목과 각 단을 출력
#include <stdio.h>

int main(void) {

    for (int i = 2; i <= 9; i++) {
        printf(" %d단  ", i);
    }
    printf("\n");


    for (int j = 1; j <= 9; j++) {
        for (int i = 2; i <= 9; i++) {
            printf("%d * %d = %2d  ", i, j, i * j);
        }
        printf("\n");
    }

    return 0;
}
