#include <stdio.h>

int main() {
    int year, month, days;

    // 입력 받기
    printf("연도를 입력하세요 : ");
    scanf("%d", &year);

    printf("특정 달을 입력하세요 : ");
    scanf("%d", &month);

    switch (month) {
        case 1: case 3: case 5: case 7:
        case 8: case 10: case 12:
            days = 31;
            break;
        case 4: case 6: case 9: case 11:
            days = 30;
            break;
        case 2:
            // 윤년 판단
            if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0))
                days = 29;
            else
                days = 28;
            break;
        default:
            printf("잘못된 달을 입력했습니다.\n");
            return 1; // 프로그램 종료
    }

    printf("%d 월의 일수는 %d입니다.\n", month, days);

    return 0;
}
