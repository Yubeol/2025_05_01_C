#include <stdio.h>

int main() {
    int num1, num2;
    char op;
    int result;

    // 입력 받기
    printf("수식 입력 (예: 10 * 3): ");
    scanf("%d %c %d", &num1, &op, &num2);

    // if문을 이용한 계산기
    if (op == '+') {
        result = num1 + num2;
        printf("결과: %d %c %d = %d\n", num1, op, num2, result);
    }
    else if (op == '-') {
        result = num1 - num2;
        printf("결과: %d %c %d = %d\n", num1, op, num2, result);
    }
    else if (op == '*') {
        result = num1 * num2;
        printf("결과: %d %c %d = %d\n", num1, op, num2, result);
    }
    else if (op == '/') {
        if (num2 == 0) {
            printf("0으로 나눌 수 없습니다.\n");
        } else {
            result = num1 / num2;
            printf("결과: %d %c %d = %d\n", num1, op, num2, result);
        }
    }
    else {
        printf("지원하지 않는 연산자입니다.\n");
    }

    return 0;
}
