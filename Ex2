//2. 간단한 계산기를 만드시오(단 if문을 이용하여 만드시오.)
//출력 예시 : 결과: 10 * 3 = 30 (0으로 나누려하면 0으로 나눌 수 없습니다.출력)
#include <stdio.h>

int main() {
    int num1, num2;
    char op;
    int result;

    printf("입력: ");
    scanf_s("%d %c %d", &num1, &op, &num2);

 
    if (op == '+') {
        result = num1 + num2;
        printf("결과: %d %c %d = %d\n", num1, op, num2, result);
    }
    else if (op == '-') {
        result = num1 - num2;
        printf("결과: %d %c %d = %d\n", num1, op, num2, result);
    }
    else if (op == '*') {
        result = num1 * num2;
        printf("결과: %d %c %d = %d\n", num1, op, num2, result);
    }
    else if (op == '/') {
        if (num2 == 0) {
            printf("0으로 나눌 수 없습니다.\n");
        }
        else {
            result = num1 / num2;
            printf("결과: %d %c %d = %d\n", num1, op, num2, result);
        }
    }
    else {
        printf("불가능한 연산자입니다.\n");
    }

    return 0;
}
