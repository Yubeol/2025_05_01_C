#include <stdio.h>

int main(void) {
    int year;

    printf("년도: ");
    scanf_s("%d", &year);

    if (year % 400 == 0) {
        printf("%d년은 윤년입니다.\n", year);
    } else if (year % 100 == 0) {
        printf("%d년은 비윤년입니다.\n", year);
    } else if (year % 4 == 0) {
        printf("%d년은 윤년입니다.\n", year);
    } else {
        printf("%d년은 비윤년입니다.\n", year);
    }

    return 0;
}
