//이중반복
#include <stdio.h>

int main(void) {
	int sum = 0;
	double avg;

	for (int i = 1; i <= 10; i++) { //for (초기값; 종료조건;증감식){반복구문}
		for (int j = 1; j <= 10; j++) { //for (초기값; 종료조건;증감식){반복구문}
			printf("%d %d\n", i, j);
			sum += i * j;
		}
	}
	avg = sum / 100.;

	printf("합:%d 평균:%.2lf\n", sum, avg);

	return 0;

}
