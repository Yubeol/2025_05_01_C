
#include <stdio.h>

int main() {
    int n;
    printf("입력: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        int temp = i;
        int clap = 0;

        // 각 자리 숫자 확인
        while (temp > 0) {
            int digit = temp % 10;
            if (digit == 3 || digit == 6 || digit == 9) {
                clap = 1;
                break;
            }
            temp /= 10;
        }

        if (clap)
            printf("짝 ");
        else
            printf("%d ", i);
    }

    printf("\n");
    return 0;
}
