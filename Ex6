//6. 이름과 점수를 입력받아서 이름 점수 등급을 출력하시오.
//등급은 100~90 A, 90~80 B, 80~70 C, 70~60 D, 그 외 F로 한다.

#include <stdio.h>

int main(void) {
    char name[20];
    int score;
    char grade1;
    char grade2[3] = "";  

    printf("이름: ");
    scanf_s("%s", name);

    printf("점수: ");
    scanf_s("%d", &score);

    switch (score / 5) {
        case 20:  
            grade1 = 'A';
            grade2[0] = '+'; 
            break;
        case 19:  
            grade1 = 'A';
            grade2[0] = '0';  
            break;
        case 18:  
            grade1 = 'A';
            grade2[0] = '0';  
            break;
        case 17:  
            grade1 = 'B';
            grade2[0] = '+';  
            break;
        case 16:  
            grade1 = 'B';
            grade2[0] = '0';  
            break;
        case 15:  
            grade1 = 'C';
            grade2[0] = '+';  
            break;
        case 14:  
            grade1 = 'C';
            grade2[0] = '0';  
            break;
        case 13:  
            grade1 = 'D';
            grade2[0] = '+';  
            break;
        case 12:  
            grade1 = 'D';
            grade2[0] = '0'; 
            break;
        default:  
            grade1 = 'F';
    }

    
    if (grade1 == 'F') {
        printf("%s %d점 %c등급\n", name, score, grade1);
    } else {
        printf("%s %d점 %c%s등급\n", name, score, grade1, grade2);
    }

    return 0;
}
